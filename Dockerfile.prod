# syntax=docker/dockerfile:1@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e
FROM oven/bun:1.4.4-alpine@sha256:4cf82f5686b196504fe119db3fcd9185b191f82ece82c40680e597228ec6070a AS base
WORKDIR /app
RUN apk add --no-cache ca-certificates

FROM base AS builder

COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

COPY src ./src
COPY public ./public
COPY scripts ./scripts
COPY tsconfig.json .
COPY components.json .
COPY bun-env.d.ts .
COPY bunfig.toml .
COPY build.ts .
COPY postbuild.ts .

RUN bun run build && rm src/server/data/ac-db.ndjson

FROM base AS bun-runtime
ADD --checksum=sha256:bf8ccbfb2b0b80159e0f9a6d15c55317add8077534dbc6130a3edb52fccb395c https://github.com/oven-sh/bun/releases/download/bun-v1.4.4/bun-linux-x64.zip /tmp/bun.zip
RUN unzip -q /tmp/bun.zip -d /tmp \
 && mkdir -p /out/usr/local/bin /out/etc \
 && cp /tmp/bun-linux-x64/bun /out/usr/local/bin/bun \
 && chmod 0755 /out/usr/local/bin/bun \
 && : > /out/etc/machine-id

FROM cgr.dev/chainguard/glibc-dynamic@sha256:709673274b417a48f56374da8a7633ef7b2f5b27e34612ce98a335737318cc94 AS runtime
WORKDIR /app
COPY --from=bun-runtime /out/ /

COPY package.json app.json ./
COPY --from=builder /app/node_modules/ws ./node_modules/ws

COPY --from=builder /app/dist ./dist
COPY --from=builder /app/src/server ./src/server
COPY --from=builder /app/src/shared ./src/shared
COPY --from=builder /app/tsconfig.json .
COPY --from=builder /app/bun-env.d.ts .

USER 710:710

ENV NODE_ENV=production

ENTRYPOINT ["/usr/local/bin/bun"]
CMD ["src/server/index.prod.ts"]
