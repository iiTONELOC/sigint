# syntax=docker/dockerfile:1
FROM oven/bun@sha256:87416c977a612a204eb54ab9f3927023c2a3c971f4f345a01da08ea6262ae30e AS base
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*

FROM base AS builder

COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

COPY src ./src
COPY public ./public
COPY scripts ./scripts
COPY tsconfig.json .
COPY components.json .
COPY bun-env.d.ts .
COPY bunfig.toml .
COPY build.ts .
COPY postbuild.ts .

RUN bun run build && rm src/server/data/ac-db.ndjson

FROM base AS runtime
RUN if getent group 710 >/dev/null || getent passwd 710 >/dev/null; then \
      echo "UID/GID 710 is taken in the base image" >&2; exit 1; \
    fi \
 && groupadd --system --gid 710 sigint \
 && useradd --system --uid 710 --gid sigint --home-dir /app --shell /usr/sbin/nologin sigint

COPY package.json app.json ./
COPY --from=builder /app/node_modules/ws ./node_modules/ws

COPY --from=builder /app/dist ./dist
COPY --from=builder /app/src/server ./src/server
COPY --from=builder /app/src/shared ./src/shared
COPY --from=builder /app/tsconfig.json .
COPY --from=builder /app/bun-env.d.ts .

USER 710:710

ENV NODE_ENV=production

CMD ["bun", "src/server/index.prod.ts"]
