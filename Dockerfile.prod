FROM oven/bun@sha256:87416c977a612a204eb54ab9f3927023c2a3c971f4f345a01da08ea6262ae30e AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*

COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

COPY src ./src
COPY public ./public
COPY scripts ./scripts
COPY tsconfig.json .
COPY components.json .
COPY bun-env.d.ts .
COPY bunfig.toml .
COPY build.ts .
COPY postbuild.ts .

RUN bun run build && rm src/server/data/ac-db.ndjson

FROM oven/bun@sha256:87416c977a612a204eb54ab9f3927023c2a3c971f4f345a01da08ea6262ae30e

WORKDIR /app

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --system --gid 10001 sigint \
 && useradd --system --uid 10001 --gid sigint --home-dir /app --shell /usr/sbin/nologin sigint

COPY --chown=sigint:sigint package.json bun.lock ./
RUN bun install --frozen-lockfile --production

COPY --from=builder --chown=sigint:sigint /app/dist ./dist
COPY --from=builder --chown=sigint:sigint /app/src/server ./src/server
COPY --from=builder --chown=sigint:sigint /app/src/shared ./src/shared
COPY --from=builder --chown=sigint:sigint /app/tsconfig.json .
COPY --from=builder --chown=sigint:sigint /app/bun-env.d.ts .

USER sigint:sigint

ENV NODE_ENV=production

CMD ["bun", "src/server/index.prod.ts"]
