# syntax=docker/dockerfile:1@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e
FROM oven/bun:1.4.4-alpine@sha256:4cf82f5686b196504fe119db3fcd9185b191f82ece82c40680e597228ec6070a AS base
WORKDIR /app
RUN apk add --no-cache ca-certificates

FROM base AS builder

COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

COPY src ./src
COPY public ./public
COPY scripts ./scripts
COPY tsconfig.json .
COPY components.json .
COPY bun-env.d.ts .
COPY bunfig.toml .
COPY build.ts .
COPY postbuild.ts .

RUN bun run build && rm src/server/data/ac-db.ndjson

FROM base AS runtime
RUN addgroup -S -g 710 sigint \
 && adduser -S -D -H -u 710 -G sigint -s /sbin/nologin sigint \
 && : > /etc/machine-id

COPY package.json app.json ./
COPY --from=builder /app/node_modules/ws ./node_modules/ws

COPY --from=builder /app/dist ./dist
COPY --from=builder /app/src/server ./src/server
COPY --from=builder /app/src/shared ./src/shared
COPY --from=builder /app/tsconfig.json .
COPY --from=builder /app/bun-env.d.ts .

USER 710:710

ENV NODE_ENV=production

CMD ["bun", "src/server/index.prod.ts"]
