# syntax=docker/dockerfile:1@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e
FROM oven/bun:1.4.4@sha256:1d22548f177f4ff38e0c15baa3c2c46c6c2060ba2d1bc573bb4720b407548f1d AS bun

FROM mcr.microsoft.com/playwright:v1.59.1-noble@sha256:b0ab6f3cb99aa7803adbc14d9027ec1785fc6e433b97e134e0f8fe61683b6b53

WORKDIR /app

RUN apt-get update \
  && apt-get upgrade -y --no-install-recommends \
  && apt-get remove -y gstreamer1.0-plugins-bad libgstreamer-plugins-bad1.0-0 \
  && rm -rf /var/lib/apt/lists/* /usr/lib/node_modules/npm \
  && rm -f /usr/bin/npm /usr/bin/npx

COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
RUN ln -s /usr/local/bin/bun /usr/local/bin/bunx

COPY package.json bun.lock ./
RUN bun install --frozen-lockfile \
  && rm -rf /root/.bun/install/cache \
    node_modules/@typescript/typescript-linux-x64 \
    node_modules/typescript

COPY src ./src
COPY public ./public
COPY tests ./tests
COPY e2e ./e2e
COPY scripts ./scripts
COPY tsconfig.json .
COPY components.json .
COPY bun-env.d.ts .
COPY bunfig.toml .
COPY build.ts .
COPY postbuild.ts .
COPY playwright.config.ts .

CMD ["bun", "run", "test:e2e"]
